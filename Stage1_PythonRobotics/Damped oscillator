import numpy as np
import matplotlib.pyplot as plt

# Initializing parameters
m = 1
k = 5
c = 2
x[0] = 4
v[0] = -3
dt = 0.001
T = 10
N = int(T/dt)
t = np.linspace(0, T, N)

# Setting up the differential equations
def dxdt(v):
    return v

def dvdt(x, v):
    return -(c/m)*v - (k/m)*x

# RK4 Loop
for i in range(N-1):
    k1x = dxdt(v[i])
    k1v = dvdt(x[i], v[i])

    k2x = dxdt(v[i] + 0.5*dt*k1v)
    k2v = dvdt(x[i] + 0.5*dt*k1x, v[i] + 0.5*dt*k1x)

    k3x = dxdt(v[i] + 0.5*dt*k2v)
    k3v = dvdt(x[i] + 0.5*dt*k2x, v[i] + 0.5*dt*k2x)

    k4x = dxdt(v[i] + dt*k3v)
    k4v = dvdt(x[i] + dt*k3x, v[i] + dt*k3x)

    x[i+1] = x[i] + (dt/6)*(k1x + 2*k2x + 2*k3x + k4x)
    v[i+1] = v[i] + (dt/6)*(k1v + 2*k2v + 2*k3v + k4v)

# Plot
plt.plot(t, x)
plt.xlabel("Time (s)")
plt.ylabel("Position (m)")
plt.title("Mass-Spring Oscillator")
plt.grid()
plt.show()
